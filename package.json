{
    "name": "dcc-rail-commander-electron",
    "version": "0.1.0-alpha.11",
    "description": "DCC-Rail-Commander - install, configure and manage firmware for DCC-EX CommandStations, IO Expanders and Turntables",
    "author": {
        "name": "DCC-EX",
        "email": "m.j.stankovich@gmail.com"
    },
    "private": true,
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "dev:mock": "electron-vite dev -- --mock-device",
        "debug": "electron-vite dev --inspect=9229",
        "build": "electron-vite build",
        "toolchain:fetch": "node scripts/fetch-toolchain.mjs",
        "postinstall": "node scripts/fetch-toolchain.mjs",
        "package": "pnpm build && electron-builder",
        "release": "node scripts/build-release.mjs",
        "docs:shots": "pnpm build && node scripts/capture-doc-screenshots.mjs",
        "preview": "electron-vite preview",
        "start": "electron-vite dev",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint src --ext .ts,.html",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "pnpm build && playwright test",
        "test:all": "pnpm test && pnpm test:e2e",
        "clean": "rimraf out src/out release dist",
        "clean:all": "pnpm run clean && rimraf node_modules src/node_modules"
    },
    "dependencies": {
        "@aurelia/dialog": "2.0.0-rc.2",
        "@aurelia/router": "2.0.0-rc.2",
        "@fontsource/roboto": "^5.3.0",
        "@syncfusion/ej2-base": "^35.1.37",
        "@syncfusion/ej2-buttons": "^35.1.41",
        "@syncfusion/ej2-dropdowns": "^35.1.46",
        "@syncfusion/ej2-inputs": "^35.1.43",
        "@syncfusion/ej2-layouts": "^35.1.41",
        "@syncfusion/ej2-navigations": "^35.1.46",
        "@syncfusion/ej2-notifications": "^35.1.37",
        "@syncfusion/ej2-tailwind-dark-theme": "^35.1.46",
        "@syncfusion/ej2-tailwind-theme": "^35.1.46",
        "@xterm/addon-canvas": "^0.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "aurelia": "2.0.0-rc.2",
        "blockly": "^13.4.0",
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.11",
        "monaco-editor": "^0.57.0",
        "python-shell": "^5.0.0",
        "serialport": "^13.0.0",
        "simple-git": "^4.1.0",
        "tar": "^7.5.23",
        "usb": "^3.3.0"
    },
    "devDependencies": {
        "@aurelia/vite-plugin": "2.0.0-rc.2",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "electron": "^45.3.3",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "js-yaml": "^5.5.0",
        "jsdom": "^31.0.1",
        "postcss-import": "^17.0.1",
        "rimraf": "^6.1.4",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-monaco-editor": "^1.1.0",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
    "build": {
        "appId": "com.dcc-rail-commander.app",
        "productName": "DCC Rail Commander",
        "directories": {
            "output": "release"
        },
        "publish": {
            "provider": "github",
            "owner": "elitemike",
            "repo": "DCC-Rail-Commander"
        },
        "npmRebuild": false,
        "compression": "maximum",
        "electronLanguages": [
            "en-US"
        ],
        "files": [
            "out/**/*",
            "package.json",
            "node_modules/**/*",
            "!node_modules/@aurelia/**/*",
            "!node_modules/aurelia/**/*",
            "!node_modules/@syncfusion/**/*",
            "!node_modules/blockly/**/*",
            "!node_modules/monaco-editor/**/*",
            "!node_modules/vite-plugin-monaco-editor/**/*",
            "!node_modules/@fontsource/**/*",
            "!node_modules/@xterm/**/*"
        ],
        "asarUnpack": [
            "**/*.node"
        ],
        "extraResources": [
            {
                "from": "src/python",
                "to": "python-scripts"
            },
            {
                "from": "resources/python",
                "to": "python"
            },
            {
                "from": "resources/pio",
                "to": "pio"
            },
            {
                "from": "resources/pio-core",
                "to": "pio-core"
            },
            {
                "from": "resources/pio-libs",
                "to": "pio-libs"
            },
            {
                "from": "resources/toolchain-manifest.json",
                "to": "toolchain-manifest.json"
            },
            {
                "from": "build/icon.png",
                "to": "icon.png"
            }
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility",
            "icon": "build/icon.png"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico",
            "artifactName": "DCC-Rail-Commander-Setup-${version}-${arch}.${ext}"
        },
        "mac": {
            "target": [
                "dmg"
            ]
        }
    }
}
